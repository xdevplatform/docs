{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "functions": {
    "api/index.js": { "includeFiles": "views/**" }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/index?__path=/" },
    { "source": "/r/:id", "destination": "/api/index?__path=/r/:id" },
    { "source": "/play/:id", "destination": "/api/index?__path=/play/:id" },
    { "source": "/card.png", "destination": "/api/index?__path=/card.png" },
    { "source": "/healthz", "destination": "/api/index?__path=/healthz" },
    { "source": "/favicon.ico", "destination": "/api/index?__path=/favicon.ico" }
  ]
}
